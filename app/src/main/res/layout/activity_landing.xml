<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/landing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

    <!-- Top Badge / Chip -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chip_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/landing_badge"
        android:textAppearance="@style/TextAppearance.Mahila.LabelMedium"
        app:chipBackgroundColor="?attr/colorPrimaryContainer"
        app:chipStrokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Hero Card with Illustration / Icon -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_hero"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/chip_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_landing_hero"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_ai_sparkle"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@string/landing_hero_desc" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- App Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Mahila.DisplaySmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintTop_toBottomOf="@id/card_hero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Subtitle / Description -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/landing_subtitle"
        android:textAppearance="@style/TextAppearance.Mahila.BodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"/>

    <!-- Feature Chips Row / Group -->
    <LinearLayout
        android:id="@+id/layout_features"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_cycle_tracker"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_ai_assistant"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_private"/>
    </LinearLayout>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp">

        <!-- Get Started CTA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_get_started"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/landing_get_started"
            android:textAppearance="@style/TextAppearance.Mahila.LabelLarge"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textEnd"
            android:elevation="4dp"/>

        <!-- Login Prompt Text -->
        <TextView
            android:id="@+id/tv_login_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_login_prompt"
            android:textAppearance="@style/TextAppearance.Mahila.BodyMedium"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
