<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header with Greeting and Profile -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Morning,"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/nunito" />

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anjali"
                    android:textSize="26sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_person"
                android:padding="10dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                android:background="?attr/colorSecondaryContainer"
                app:tint="?attr/colorOnSecondaryContainer" />
        </RelativeLayout>

        <!-- Main Cycle Phase Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!-- Phase Badge -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_phase_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ovulatory Phase"
                    app:chipBackgroundColor="?attr/colorSecondary"
                    android:textColor="?attr/colorOnSecondary"
                    app:chipCornerRadius="16dp"
                    app:chipMinTouchTargetSize="0dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/nunito" />

                <TextView
                    android:id="@+id/tv_cycle_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Day 14"
                    android:textSize="42sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito" />

                <TextView
                    android:id="@+id/tv_cycle_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peak Fertility Window"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginVertical="18dp"
                    android:alpha="0.6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next Period"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:fontFamily="@font/nunito" />

                        <TextView
                            android:id="@+id/tv_next_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oct 24, 2026"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/nunito" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fertile Window"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:fontFamily="@font/nunito" />

                        <TextView
                            android:id="@+id/tv_fertile_window"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oct 08 – Oct 14"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/nunito" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/nunito" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_log_period"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Log Period"
                android:textSize="14sp"
                app:icon="@drawable/ic_nav_tracker"
                app:iconSize="20dp"
                app:cornerRadius="14dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/nunito" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_ai_chat"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="AI Assistant"
                android:textSize="13sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:icon="@drawable/ic_ai_sparkle"
                app:iconSize="20dp"
                app:cornerRadius="14dp"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/nunito" />
        </LinearLayout>

        <!-- Health Analytics & Insights Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_insights_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/muted_rose"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/warm_sand"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Insights &amp; Cycle Analytics"
                        android:textColor="@color/deep_plum"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Analyze cycle regularity, symptom occurrences, and observational trends"
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        android:fontFamily="@font/nunito" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_insights"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View"
                    android:textSize="12sp"
                    android:fontFamily="@font/nunito" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Personalized Nutrition Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nutrition_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/sage_green"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/warm_sand"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nutrition &amp; Diet Advice"
                        android:textColor="@color/deep_plum"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Phase-aware evidence-based meal plans and nutrient recommendations"
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        android:fontFamily="@font/nunito" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_nutrition"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View"
                    android:textSize="12sp"
                    android:fontFamily="@font/nunito" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Health Insights Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ai_sparkle"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Cycle Insight"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/nunito" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ai_insight_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You are entering your ovulatory phase. Stay well hydrated and eat magnesium-rich foods to maintain optimal energy."
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="@font/nunito" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
