<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medical Assistance &amp; Map"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Interactive Map Fragment Container Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/map_fragment"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tv_map_placeholder_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="🗺️  Interactive Google Maps View\n(Map SDK embedded. Requires MAPS_API_KEY in local.properties)"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Find Care Near You Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Women's Healthcare Nearby"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="City or Location Name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        android:layout_marginEnd="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_location_query"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_use_gps"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:text="Use GPS"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_map_gyno"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:text="Gynecologists"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_map_hospitals"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:text="Hospitals"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_map_clinics"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:text="Clinics"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_map_women_centers"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:text="Women Centers"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Provider Results Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nearby Healthcare Provider Results"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_provider_results_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a category above or enter a city to search for nearby verified providers."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/container_provider_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <!-- Personal Age Recommendation Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_age_recommendation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personalised Healthcare Guidance"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_age_recommendation_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complete your profile details to see tailored health specialist recommendations."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
